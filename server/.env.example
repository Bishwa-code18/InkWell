PORT=5000
NODE_ENV=development

# MongoDB
# Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/inkwell?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/inkwell

# JWT — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=your_access_secret_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production

# OAuth (set to "skip" to disable)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=skip
GITHUB_CLIENT_SECRET=skip

# Cloudinary (set to "skip" to disable uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis (leave as localhost for local dev — gracefully degrades if unavailable)
REDIS_URL=redis://localhost:6379

# Email (set to "skip" to disable emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# App URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Cookie secret — generate with: openssl rand -hex 32
COOKIE_SECRET=your_cookie_secret_here_change_in_production

# ─── Production overrides ───────────────────────────────────────────────────
# Set these in your hosting platform's environment variables, NOT in this file:
# NODE_ENV=production
# MONGODB_URI=<your Atlas URI>
# JWT_ACCESS_SECRET=<openssl rand -hex 32>
# JWT_REFRESH_SECRET=<openssl rand -hex 32>
# COOKIE_SECRET=<openssl rand -hex 32>
# CLIENT_URL=https://your-frontend.vercel.app
# SERVER_URL=https://your-api.onrender.com
# GOOGLE_CLIENT_ID=<your prod Google client ID>
# GOOGLE_CLIENT_SECRET=<your prod Google client secret>
# CLOUDINARY_CLOUD_NAME=<your cloud name>
# CLOUDINARY_API_KEY=<your api key>
# CLOUDINARY_API_SECRET=<your api secret>
# EMAIL_HOST=smtp.gmail.com
# EMAIL_USER=<your email>
# EMAIL_PASS=<your app password>
# REDIS_URL=redis://<your Redis cloud URL>
